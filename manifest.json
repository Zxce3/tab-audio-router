{
  "manifest_version": 3,
  "name": "Tab Audio Router",
  "version": "1.2.0",
  "description": "Send each tab's audio to a different output device (speakers, headphones, Bluetooth, etc).",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "activeTab",
    "offscreen",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Audio Router",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}